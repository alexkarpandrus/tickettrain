#!/usr/bin/env bash
set -euo pipefail

# One-liner install:
#   curl -fsSL https://raw.githubusercontent.com/alexkarpandrus/tickettrain/main/bin/install | bash
# Or from a local clone:
#   ./bin/install

REPO_URL="https://github.com/alexkarpandrus/tickettrain.git"
INSTALL_DIR="${TTT_INSTALL_DIR:-${HOME}/.local/share/tickettrain}"
BIN_DIR="${HOME}/.local/bin"

if ! command -v git >/dev/null 2>&1; then
  echo "tickettrain requires git. Install it from https://git-scm.com/downloads and rerun this installer." >&2
  exit 1
fi

if ! command -v bb >/dev/null 2>&1 && [[ ! -x "${HOME}/.local/bin/bb" ]]; then
  echo "tickettrain requires Babashka 1.12.217 or newer. Install it from https://babashka.org/ and rerun this installer." >&2
  exit 1
fi

# When piped through `curl | bash`, BASH_SOURCE[0] is "bash" (no real file), so
# we clone/update the repo. When run from a checkout, use the checkout itself.
if [[ -n "${BASH_SOURCE[0]:-}" && -f "${BASH_SOURCE[0]}" ]]; then
  SOURCE="${BASH_SOURCE[0]}"
  while [ -L "${SOURCE}" ]; do
    SCRIPT_DIR="$(cd -P "$(dirname "${SOURCE}")" && pwd)"
    SOURCE="$(readlink "${SOURCE}")"
    [[ "${SOURCE}" != /* ]] && SOURCE="${SCRIPT_DIR}/${SOURCE}"
  done
  ROOT_DIR="$(cd -P "$(dirname "${SOURCE}")/.." && pwd)"
else
  RELEASE_TAG="$(git ls-remote --tags --refs --sort=-v:refname "${REPO_URL}" 'v[0-9]*' | awk 'NR == 1 { sub("refs/tags/", "", $2); print $2 }')"
  if [[ -z "${RELEASE_TAG}" ]]; then
    echo "No tickettrain release is available yet." >&2
    exit 1
  fi
  if [[ -d "${INSTALL_DIR}/.git" ]]; then
    git -C "${INSTALL_DIR}" fetch --depth 1 origin "refs/tags/${RELEASE_TAG}:refs/tags/${RELEASE_TAG}" --quiet
    git -C "${INSTALL_DIR}" checkout --detach --quiet "${RELEASE_TAG}"
  else
    git clone --depth 1 --branch "${RELEASE_TAG}" "${REPO_URL}" "${INSTALL_DIR}"
  fi
  ROOT_DIR="${INSTALL_DIR}"
fi

mkdir -p "${BIN_DIR}"
ln -sfn "${ROOT_DIR}/bin/ttt" "${BIN_DIR}/ttt"
"${BIN_DIR}/ttt" version >/dev/null

echo "Installed and verified:"
echo "  ttt -> ${BIN_DIR}/ttt"

case ":${PATH:-}:" in
  *":${BIN_DIR}:"*) ;;
  *)
    echo
    echo "Add tickettrain to your PATH:"
    echo "  export PATH=\"${BIN_DIR}:\$PATH\""
    echo "Add that line to your shell profile, then open a new terminal."
    ;;
esac

echo
echo "Optional: install the agent skill for Claude Code, Codex, Cursor, and more:"
echo "  npx skills add alexkarpandrus/tickettrain"
echo
echo "Next: enter a target repository and run 'ttt setup', then 'ttt --llm' for agent instructions."
