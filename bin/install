#!/usr/bin/env bash
set -euo pipefail

# One-liner install:
#   curl -fsSL https://raw.githubusercontent.com/alexkarpandrus/tickettrain/main/bin/install | bash
# Or from a local clone:
#   ./bin/install

REPO_URL="https://github.com/alexkarpandrus/tickettrain.git"
INSTALL_DIR="${TTT_INSTALL_DIR:-${HOME}/.local/share/tickettrain}"
BIN_DIR="${HOME}/.local/bin"
BABASHKA_VERSION="1.12.217"
BABASHKA_INSTALL_URL="https://raw.githubusercontent.com/babashka/babashka/v${BABASHKA_VERSION}/install"
UPDATE_ONLY=false

if [[ "${1:-}" == "--update" ]]; then
  UPDATE_ONLY=true
  shift
fi
if (( $# )); then
  echo "Usage: install [--update]" >&2
  exit 1
fi

confirm_babashka_install() {
  local answer=""
  local input="/dev/tty"
  if [[ -n "${BASH_SOURCE[0]:-}" && -f "${BASH_SOURCE[0]}" ]]; then
    input="/dev/stdin"
  fi
  [[ -r "${input}" ]] || return 1
  printf 'Babashka %s+ is required. Install %s to %s? [y/N] ' "${BABASHKA_VERSION}" "${BABASHKA_VERSION}" "${BIN_DIR}" >&2
  IFS= read -r answer <"${input}" 2>/dev/null || true
  [[ "${answer}" =~ ^([yY]|[yY][eE][sS])$ ]]
}

if ! command -v git >/dev/null 2>&1; then
  echo "tickettrain requires git. Install it from https://git-scm.com/downloads and rerun this installer." >&2
  exit 1
fi

if ! command -v bb >/dev/null 2>&1 && [[ ! -x "${BIN_DIR}/bb" ]]; then
  if confirm_babashka_install; then
    if ! command -v curl >/dev/null 2>&1; then
      echo "Babashka installation requires curl. Install it and rerun this installer." >&2
      exit 1
    fi
    mkdir -p "${BIN_DIR}"
    if ! curl -fsSL "${BABASHKA_INSTALL_URL}" | /bin/bash -s -- --dir "${BIN_DIR}" --version "${BABASHKA_VERSION}"; then
      echo "Babashka installation failed. Install it from https://babashka.org/ and rerun this installer." >&2
      exit 1
    fi
    if [[ ! -x "${BIN_DIR}/bb" ]]; then
      echo "Babashka installation did not create ${BIN_DIR}/bb." >&2
      exit 1
    fi
    echo "✓ Installed Babashka ${BABASHKA_VERSION}."
  else
    echo "tickettrain requires Babashka ${BABASHKA_VERSION} or newer. Install it from https://babashka.org/ and rerun this installer." >&2
    exit 1
  fi
fi

latest_release_tag() {
  local tag
  tag="$(git ls-remote --tags --refs --sort=-v:refname "${REPO_URL}" 'v[0-9]*' | awk '$2 ~ /^refs\/tags\/v[0-9]+\.[0-9]+\.[0-9]+$/ { sub("refs/tags/", "", $2); print $2; exit }')"
  if [[ -z "${tag}" ]]; then
    echo "No tickettrain release is available yet." >&2
    exit 1
  fi
  printf '%s\n' "${tag}"
}

update_checkout() {
  local root_dir="$1"
  local release_tag="$2"
  git -C "${root_dir}" fetch --depth 1 "${REPO_URL}" "refs/tags/${release_tag}:refs/tags/${release_tag}" --quiet
  git -C "${root_dir}" checkout --detach --quiet "${release_tag}"
}

# When piped through `curl | bash`, BASH_SOURCE[0] is "bash" (no real file), so
# we clone/update the repo. When run from a checkout, use the checkout itself.
if [[ -n "${BASH_SOURCE[0]:-}" && -f "${BASH_SOURCE[0]}" ]]; then
  SOURCE="${BASH_SOURCE[0]}"
  while [ -L "${SOURCE}" ]; do
    SCRIPT_DIR="$(cd -P "$(dirname "${SOURCE}")" && pwd)"
    SOURCE="$(readlink "${SOURCE}")"
    [[ "${SOURCE}" != /* ]] && SOURCE="${SCRIPT_DIR}/${SOURCE}"
  done
  ROOT_DIR="$(cd -P "$(dirname "${SOURCE}")/.." && pwd)"
else
  RELEASE_TAG="$(latest_release_tag)"
  if [[ -d "${INSTALL_DIR}/.git" ]]; then
    update_checkout "${INSTALL_DIR}" "${RELEASE_TAG}"
  else
    git clone --depth 1 --branch "${RELEASE_TAG}" "${REPO_URL}" "${INSTALL_DIR}"
  fi
  ROOT_DIR="${INSTALL_DIR}"
  : > "${ROOT_DIR}/.git/ttt-install"
fi

if [[ "${UPDATE_ONLY}" == true ]]; then
  if ! git -C "${ROOT_DIR}" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    echo "ttt update requires a Git-based release installation." >&2
    exit 1
  fi
  if [[ ! -f "${ROOT_DIR}/.git/ttt-install" ]]; then
    echo "ttt update only works for installer-managed release installations. Run the install command once to enable updates." >&2
    exit 1
  fi
  if git -C "${ROOT_DIR}" symbolic-ref -q HEAD >/dev/null 2>&1; then
    echo "ttt update only works for a tagged release installation. Use Git to update a source checkout." >&2
    exit 1
  fi
  CURRENT_TAG="$(git -C "${ROOT_DIR}" describe --tags --exact-match HEAD 2>/dev/null || true)"
  if [[ ! "${CURRENT_TAG}" =~ ^v[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
    echo "ttt update requires the current checkout to match a version tag." >&2
    exit 1
  fi
  if [[ -n "$(git -C "${ROOT_DIR}" status --porcelain)" ]]; then
    echo "ttt update refused because the installation has local changes." >&2
    exit 1
  fi
  RELEASE_TAG="$(latest_release_tag)"
  if [[ "${CURRENT_TAG}" == "${RELEASE_TAG}" ]]; then
    "${ROOT_DIR}/bin/ttt" version >/dev/null
    echo "✓ ttt ${CURRENT_TAG#v} is already up to date."
    exit 0
  fi
  update_checkout "${ROOT_DIR}" "${RELEASE_TAG}"
  if ! "${ROOT_DIR}/bin/ttt" version >/dev/null; then
    git -C "${ROOT_DIR}" checkout --detach --quiet "${CURRENT_TAG}"
    echo "Update verification failed; restored ttt ${CURRENT_TAG#v}." >&2
    exit 1
  fi
  echo "✓ Updated ttt ${CURRENT_TAG#v} → ${RELEASE_TAG#v}."
  exit 0
fi

mkdir -p "${BIN_DIR}"
ln -sfn "${ROOT_DIR}/bin/ttt" "${BIN_DIR}/ttt"
"${BIN_DIR}/ttt" version >/dev/null

echo "✓ Installed and verified:"
echo "  ttt → ${BIN_DIR}/ttt"

case ":${PATH:-}:" in
  *":${BIN_DIR}:"*) ;;
  *)
    echo
    echo "⚠ Add tickettrain to your PATH:"
    echo "  export PATH=\"${BIN_DIR}:\$PATH\""
    echo "Add that line to your shell profile, then open a new terminal."
    ;;
esac

echo
echo "→ Optional: install the agent skill for Claude Code, Codex, Cursor, and more:"
echo "  npx skills add alexkarpandrus/tickettrain"
echo
echo "→ Next: enter a target repository and run 'ttt setup', then 'ttt --llm' for agent instructions."
